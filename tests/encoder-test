#include "driverlib.h"
#include <stdint.h>
#include <stdio.h>
#include <math.h>
#include "../inc/SysTick.h"
#include "../inc/Clock.h"

//==============================================================================
// CONFIG
//==============================================================================

#define WHEEL_DIAMETER_MM       70.0f
#define WHEELBASE_MM            140.0f
#define ENCODER_COUNTS_PER_REV  360

#define WHEEL_CIRCUMFERENCE_MM  (WHEEL_DIAMETER_MM * 3.14159f)
#define MM_PER_COUNT            (WHEEL_CIRCUMFERENCE_MM / ENCODER_COUNTS_PER_REV)

#define TIMER_PERIOD            15000
#define MOTOR_SPEED             2000

//==============================================================================
// GLOBAL VARIABLES
//==============================================================================

// Encoder counts (volatile - modified in ISR)
volatile int32_t left_count = 0;
volatile int32_t right_count = 0;
volatile int32_t left_last = 0;
volatile int32_t right_last = 0;

// Odometry
float robot_x = 0.0f;
float robot_y = 0.0f;
float robot_theta = 0.0f;
float distance_traveled = 0.0f;

// PWM configs
Timer_A_UpDownModeConfig upDownConfig =
{
    TIMER_A_CLOCKSOURCE_SMCLK,
    TIMER_A_CLOCKSOURCE_DIVIDER_4,
    TIMER_PERIOD,
    TIMER_A_TAIE_INTERRUPT_DISABLE,
    TIMER_A_CCIE_CCR0_INTERRUPT_DISABLE,
    TIMER_A_DO_CLEAR
};

Timer_A_CompareModeConfig compareConfig_PWM1 =
{
    TIMER_A_CAPTURECOMPARE_REGISTER_1,
    TIMER_A_CAPTURECOMPARE_INTERRUPT_DISABLE,
    TIMER_A_OUTPUTMODE_TOGGLE_RESET,
    0
};

Timer_A_CompareModeConfig compareConfig_PWM2 =
{
    TIMER_A_CAPTURECOMPARE_REGISTER_2,
    TIMER_A_CAPTURECOMPARE_INTERRUPT_DISABLE,
    TIMER_A_OUTPUTMODE_TOGGLE_RESET,
    0
};

//==============================================================================
// UART FUNCTIONS
//==============================================================================

void UART_init(void)
{
    P1->SEL0 |= BIT2 | BIT3;
    P1->SEL1 &= ~(BIT2 | BIT3);

    EUSCI_A0->CTLW0 = EUSCI_A_CTLW0_SWRST;
    EUSCI_A0->CTLW0 |= EUSCI_A_CTLW0_SSEL__SMCLK;

    EUSCI_A0->BRW = 6;
    EUSCI_A0->MCTLW = (8 << 4) | (0x20 << 8) | EUSCI_A_MCTLW_OS16;

    EUSCI_A0->CTLW0 &= ~EUSCI_A_CTLW0_SWRST;
}

void UART_print(char *str)
{
    while (*str)
    {
        while (!(EUSCI_A0->IFG & EUSCI_A_IFG_TXIFG));
        EUSCI_A0->TXBUF = *str++;
    }
}

void UART_printInt(int32_t val)
{
    char buf[16];
    sprintf(buf, "%ld", val);
    UART_print(buf);
}

void UART_printFloat(float val)
{
    char buf[16];
    sprintf(buf, "%.1f", val);
    UART_print(buf);
}

//==============================================================================
// MOTOR FUNCTIONS (from your working code)
//==============================================================================

void PWM_duty1(uint16_t duty)
{
    if (duty >= TIMER_PERIOD) return;
    compareConfig_PWM1.compareValue = duty;
    Timer_A_initCompare(TIMER_A0_BASE, &compareConfig_PWM1);
}

void PWM_duty2(uint16_t duty)
{
    if (duty >= TIMER_PERIOD) return;
    compareConfig_PWM2.compareValue = duty;
    Timer_A_initCompare(TIMER_A0_BASE, &compareConfig_PWM2);
}

void Motors_init(void)
{
    // PWM pins: P2.4 (right), P2.5 (left)
    GPIO_setAsPeripheralModuleFunctionOutputPin(
        GPIO_PORT_P2,
        GPIO_PIN4 | GPIO_PIN5,
        GPIO_PRIMARY_MODULE_FUNCTION
    );

    // Direction pins: P3.0 (right), P3.6 (left)
    GPIO_setAsOutputPin(GPIO_PORT_P3, GPIO_PIN0 | GPIO_PIN6);

    // nSLP pins: P3.5 (right), P3.7 (left)
    GPIO_setAsOutputPin(GPIO_PORT_P3, GPIO_PIN5 | GPIO_PIN7);

    // Timer_A0 PWM setup
    Timer_A_configureUpDownMode(TIMER_A0_BASE, &upDownConfig);
    Timer_A_startCounter(TIMER_A0_BASE, TIMER_A_UPDOWN_MODE);
    Timer_A_initCompare(TIMER_A0_BASE, &compareConfig_PWM1);
    Timer_A_initCompare(TIMER_A0_BASE, &compareConfig_PWM2);
}

void Motors_forward(uint16_t speed)
{
    GPIO_setOutputLowOnPin(GPIO_PORT_P3, GPIO_PIN5 | GPIO_PIN7);
    GPIO_setOutputHighOnPin(GPIO_PORT_P3, GPIO_PIN0 | GPIO_PIN6);
    PWM_duty1(speed);
    PWM_duty2(speed);
}

void Motors_backward(uint16_t speed)
{
    GPIO_setOutputHighOnPin(GPIO_PORT_P3, GPIO_PIN5 | GPIO_PIN7);
    GPIO_setOutputHighOnPin(GPIO_PORT_P3, GPIO_PIN0 | GPIO_PIN6);
    PWM_duty1(speed);
    PWM_duty2(speed);
}

void Motors_turnLeft(uint16_t speed)
{
    GPIO_setOutputLowOnPin(GPIO_PORT_P3, GPIO_PIN5);
    GPIO_setOutputHighOnPin(GPIO_PORT_P3, GPIO_PIN7);
    GPIO_setOutputHighOnPin(GPIO_PORT_P3, GPIO_PIN0 | GPIO_PIN6);
    PWM_duty1(speed);
    PWM_duty2(speed);
}

void Motors_turnRight(uint16_t speed)
{
    GPIO_setOutputHighOnPin(GPIO_PORT_P3, GPIO_PIN5);
    GPIO_setOutputLowOnPin(GPIO_PORT_P3, GPIO_PIN7);
    GPIO_setOutputHighOnPin(GPIO_PORT_P3, GPIO_PIN0 | GPIO_PIN6);
    PWM_duty1(speed);
    PWM_duty2(speed);
}

void Motors_stop(void)
{
    PWM_duty1(0);
    PWM_duty2(0);
}

//==============================================================================
// ENCODER FUNCTIONS
//==============================================================================

void Encoders_init(void)
{
    // Left Encoder: A = P10.5, B = P5.2
    P10->DIR &= ~BIT5;
    P10->REN |= BIT5;
    P10->OUT |= BIT5;

    P5->DIR &= ~BIT2;
    P5->REN |= BIT2;
    P5->OUT |= BIT2;

    // Right Encoder: A = P10.4, B = P5.0
    P10->DIR &= ~BIT4;
    P10->REN |= BIT4;
    P10->OUT |= BIT4;

    P5->DIR &= ~BIT0;
    P5->REN |= BIT0;
    P5->OUT |= BIT0;

    // Interrupts on B channels (P5.0 and P5.2)
    P5->IES &= ~(BIT0 | BIT2);   // Rising edge
    P5->IFG &= ~(BIT0 | BIT2);   // Clear flags
    P5->IE  |= (BIT0 | BIT2);    // Enable interrupts

    // Enable Port 5 interrupt in NVIC
    NVIC_SetPriority(PORT5_IRQn, 2);
    NVIC_EnableIRQ(PORT5_IRQn);
}

void Encoders_reset(void)
{
    __disable_irq();
    left_count = 0;
    right_count = 0;
    left_last = 0;
    right_last = 0;
    __enable_irq();
}

int32_t Encoders_getLeftDelta(void)
{
    __disable_irq();
    int32_t delta = left_count - left_last;
    left_last = left_count;
    __enable_irq();
    return delta;
}

int32_t Encoders_getRightDelta(void)
{
    __disable_irq();
    int32_t delta = right_count - right_last;
    right_last = right_count;
    __enable_irq();
    return delta;
}

// Port 5 ISR - Quadrature decoding
void PORT5_IRQHandler(void)
{
    uint8_t flags = P5->IFG;

    // Left Encoder (B = P5.2, A = P10.5)
    if (flags & BIT2)
    {
        uint8_t b_state = P5->IN & BIT2;
        uint8_t a_state = P10->IN & BIT5;

        if (b_state)  // B rising
        {
            if (a_state)
                left_count--;
            else
                left_count++;
        }
        else  // B falling
        {
            if (a_state)
                left_count++;
            else
                left_count--;
        }

        P5->IES ^= BIT2;    // Toggle edge
        P5->IFG &= ~BIT2;   // Clear flag
    }

    // Right Encoder (B = P5.0, A = P10.4)
    if (flags & BIT0)
    {
        uint8_t b_state = P5->IN & BIT0;
        uint8_t a_state = P10->IN & BIT4;

        if (b_state)  // B rising
        {
            if (a_state)
                right_count++;
            else
                right_count--;
        }
        else  // B falling
        {
            if (a_state)
                right_count--;
            else
                right_count++;
        }

        P5->IES ^= BIT0;    // Toggle edge
        P5->IFG &= ~BIT0;   // Clear flag
    }
}

//==============================================================================
// ODOMETRY FUNCTIONS
//==============================================================================

void Odometry_reset(void)
{
    robot_x = 0.0f;
    robot_y = 0.0f;
    robot_theta = 0.0f;
    distance_traveled = 0.0f;
    Encoders_reset();
}

void Odometry_update(void)
{
    int32_t left_delta = Encoders_getLeftDelta();
    int32_t right_delta = Encoders_getRightDelta();

    float left_mm = left_delta * MM_PER_COUNT;
    float right_mm = right_delta * MM_PER_COUNT;

    float center_mm = (left_mm + right_mm) / 2.0f;
    float delta_theta = (right_mm - left_mm) / WHEELBASE_MM;

    float mid_theta = robot_theta + delta_theta / 2.0f;

    robot_x += center_mm * cosf(mid_theta);
    robot_y += center_mm * sinf(mid_theta);
    robot_theta += delta_theta;

    // Normalize theta to [-PI, PI]
    while (robot_theta > 3.14159f)  robot_theta -= 2.0f * 3.14159f;
    while (robot_theta < -3.14159f) robot_theta += 2.0f * 3.14159f;

    distance_traveled += fabsf(center_mm);
}

//==============================================================================
// MAIN
//==============================================================================
int main(void)
{
    int i;
    uint8_t la, lb, ra, rb;

    WDT_A->CTL = WDT_A_CTL_PW | WDT_A_CTL_HOLD;

    Clock_Init48MHz();
    UART_init();
    SysTick_Init();
    Motors_init();

    // Encoder pins - no pull resistor (let encoder drive it)
    P10->DIR &= ~(BIT4 | BIT5);
    P10->REN &= ~(BIT4 | BIT5);  // Disable pull resistors

    P5->DIR &= ~(BIT0 | BIT2);
    P5->REN &= ~(BIT0 | BIT2);   // Disable pull resistors

    UART_print("\r\n=== ENCODER TEST WITH MOTORS ===\r\n\r\n");

    // Run motors
    Motors_forward(2000);

    for (i = 0; i < 50; i++)
    {
        la = (P10->IN & BIT5) ? 1 : 0;
        lb = (P5->IN & BIT2) ? 1 : 0;
        ra = (P10->IN & BIT4) ? 1 : 0;
        rb = (P5->IN & BIT0) ? 1 : 0;

        UART_print("L:");
        UART_printInt(la);
        UART_printInt(lb);
        UART_print(" R:");
        UART_printInt(ra);
        UART_printInt(rb);
        UART_print("\r\n");

        SysTick_Wait10ms(5);  // Faster sampling
    }

    Motors_stop();
    UART_print("\r\nDone.\r\n");

    while (1);
}
